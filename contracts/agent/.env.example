# ── Substrate / Portaldot ─────────────────────────────────
RPC_URL=wss://rpc.polkadot.io
CONTRACT_ADDRESS=5Gxxx...your_deployed_contract_address

# ── Signer (the account that submits execute_rule) ────────
# Anyone can call execute_rule — does not have to be the owner
SIGNER_MNEMONIC=word1 word2 word3 ... word12

# ── Price Feed ────────────────────────────────────────────
COINGECKO_COIN_ID=polkadot
COINGECKO_VS_CURRENCY=usd

# ── Rule Mirror (must match what you set on-chain) ────────
# $4.00 = 4000000 (6dp scaled)
THRESHOLD_PRICE=4000000
IS_BELOW=true

# ── Watcher Behaviour ─────────────────────────────────────
POLL_INTERVAL_SECONDS=30
MAX_CONSECUTIVE_FAILURES=5
GAS_LIMIT=5000000000

# ── Demo Mode ─────────────────────────────────────────────
# Set DEMO_MODE=true for hackathon demo — bypasses live price
# DEMO_OVERRIDE_PRICE must satisfy the rule condition
DEMO_MODE=false
DEMO_OVERRIDE_PRICE=3500000